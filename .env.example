# Copy to a private location (for example /srv/urio-dashboard/.env) and chmod 600.
# The installation wizard creates SECRET_KEY, ADMIN_PASSWORD_HASH and
# CREDENTIAL_ENCRYPTION_KEY automatically when this file is writable.

APP_ENV=production
PORT=8000
# DATABASE_URL=sqlite:////srv/urio-dashboard/data/transfer_stats.db
# INSTANCE_DIR=/srv/urio-dashboard/data/instance
# URIO_ENV_FILE=/srv/urio-dashboard/.env

# Required when serving through HTTPS (the production default is true).
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax
ENABLE_HSTS=true
TRUST_PROXY_HEADERS=false

# Comma-separated exact origins only for a separately hosted frontend.
# Leave blank for the bundled same-origin frontend.
CORS_ALLOWED_ORIGINS=

# Exactly one process/container may set this to true.
RUN_SCHEDULER=true
AUTO_REMOVE_OFFLINE_DEVICES=false
STATS_RETENTION_DAYS=90
PROVIDER_STATS_RETENTION_DAYS=90

# Discord webhook destinations are intentionally allowlisted to prevent SSRF.
WEBHOOK_ALLOWED_HOSTS=discord.com,discordapp.com,canary.discord.com,ptb.discord.com
